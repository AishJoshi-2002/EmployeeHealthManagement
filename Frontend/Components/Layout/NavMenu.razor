@rendermode InteractiveServer

<div class="sidebar @(isCollapsed ? "collapsed" : "")">

    <div class="sidebar-top">

        <!-- LOGO -->
        @if (!isCollapsed)
        {
            <!-- LOGO -->
            <div class="logo-container">
                <img src="images/logo.png" alt="Logo" class="logo" />
            </div>
        }

        <button type="button" class="toggle-btn" @onclick="ToggleSidebar">
            ☰
        </button>

    </div>

    <div class="nav-scrollable">
        <nav class="nav flex-column">

            <div class="nav-heading @((isCollapsed) ? "nav-heading-collapsed" : "")">ADMIN</div>
            <div class="sub-box">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-list" aria-hidden="true"></span>
                        @if (!isCollapsed)
                        {
                            <span>Hospital Master</span>
                        }
                    </NavLink>
                    <div class="sub-sub-box">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="add-hospital">
                                <span class="bi bi-grid-1x2" aria-hidden="true"></span> Add Hospital
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="update-hospital">
                                <span class="bi bi-grid-1x2" aria-hidden="true"></span> Update Hospital
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="update-hospital-rates">
                                <span class="bi bi-grid-1x2" aria-hidden="true"></span> Update Hospital
                                Rates
                            </NavLink>
                        </div>
                    </div>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="city-master">
                        <span class="bi bi-list" aria-hidden="true"></span> City Master
                    </NavLink>
                </div>
            </div>


            <div class="nav-heading">EMPLOYEE</div>
            <div class="sub-box">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="executive-health-checkup">
                        <span class="bi bi-list" aria-hidden="true"></span> Executive Health Checkup
                    </NavLink>
                    <div class="sub-sub-box">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="health-checkup-request">
                                <span class="bi bi-grid-1x2" aria-hidden="true"></span> Health Checkup Request
                            </NavLink>
                        </div>
                    </div>
                </div>
            </div>


            <div class="nav-heading">SBU</div>
            <div class="sub-box">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="sbu-approve-reject">
                        <span class="bi bi-list" aria-hidden="true"></span> Approve/Reject
                    </NavLink>
                </div>
            </div>


            <div class="nav-heading">HR</div>
            <div class="sub-box">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="hr-approve-reject">
                        <span class="bi bi-list" aria-hidden="true"></span> Approve/Reject
                    </NavLink>
                </div>
            </div>


            <div class="nav-heading">FINANCE</div>
            <div class="sub-box">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="bill">
                        <span class="bi bi-list" aria-hidden="true"></span> Bill
                    </NavLink>
                    <div class="sub-sub-box">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="prepare-bill">
                                <span class="bi bi-grid-1x2" aria-hidden="true"></span> Prepare Bill
                            </NavLink>
                        </div>
                    </div>
                </div>
            </div>

        </nav>
    </div>
</div>

@code {
    private bool isCollapsed = false;

    private void ToggleSidebar()
    {
        isCollapsed = !isCollapsed;
        @* Console.WriteLine(isCollapsed); *@
    }
}